# Use an absolute host path. The same path is mounted read-only inside the container,
# so agents can register projects using their normal host paths.
CODE_CONTEXT_PROJECTS_ROOT=/home/your-user/projects

# GB10-safe defaults. Because the container intentionally does not use CUDA,
# this cgroup memory limit is enforceable by Docker.
CODE_CONTEXT_MEMORY_LIMIT=8g
CODE_CONTEXT_MEMORY_RESERVATION=2g
CODE_CONTEXT_CPU_LIMIT=4.0
CODE_CONTEXT_CPU_THREADS=4
CODE_CONTEXT_PORT=7438

# Optional if Hugging Face authentication is required for the model.
# HF_TOKEN=
