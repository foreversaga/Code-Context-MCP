# Required host project root.
CODE_CONTEXT_PROJECTS_ROOT=/home/your-user/projects

# Docker CPU-side cgroup limit.
CODE_CONTEXT_MEMORY_LIMIT=8g
CODE_CONTEXT_MEMORY_RESERVATION=2g
CODE_CONTEXT_CPU_LIMIT=4.0
CODE_CONTEXT_CPU_THREADS=4
CODE_CONTEXT_PORT=7438

# MPS v3 device-memory limits, in MiB.
# 4096 MiB is ample for the 270M text/code EmbeddingGemma 2 path.\n# Soft limit defaults to 0 to avoid persistent dmem ancestor reservations.
CODE_CONTEXT_MPS_HARD_LIMIT_MIB=4096
CODE_CONTEXT_MPS_SOFT_LIMIT_MIB=0
CODE_CONTEXT_GPU_INDEX=0

# Secondary PyTorch allocator ceiling inside the MPS hard limit.
CODE_CONTEXT_TORCH_GPU_FRACTION=0.90

# Optional Hugging Face token.
# HF_TOKEN=
